---
/** Premium (`/site/premium` du lab) : liste d'attente Premium, comparaison des offres, question. */
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqList from "../components/FaqList.astro";
import PageHero from "../components/PageHero.astro";
import PlanCompare from "../components/PlanCompare.astro";
import SiteSection from "../components/SiteSection.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import { FAQ_HOME, PREMIUM } from "../data/site";
---

<BaseLayout
  title="Premium"
  description="Premium arrive bientôt : il retirera la publicité et élargira les limites de défis et de salons, sans aucun avantage en duel."
  current="/premium/"
>
  <PageHero eyebrow={PREMIUM.eyebrow} title={PREMIUM.title} lede={PREMIUM.lede}>
    <div class="pt-4">
      <WaitlistForm
        kind="premium"
        action="Me prévenir"
        note="Un seul e-mail, à la sortie de Premium. Pas de spam, désinscription en un clic."
        success="C’est noté. On t’écrit une seule fois, à la sortie de Premium."
      />
    </div>
  </PageHero>
  <SiteSection title="Ce qui change, ce qui ne change pas">
    <PlanCompare />
  </SiteSection>
  <SiteSection tone="warm" title="Questions fréquentes">
    <FaqList items={[FAQ_HOME[1]!]} />
  </SiteSection>
</BaseLayout>
