---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Premium"
  description="Premium arrive bientôt : il retirera la publicité et élargira les limites de défis et de salons, sans aucun avantage en duel."
>
  <div class="premium-page">
    <span class="premium-page__eyebrow">Premium</span>
    <h1>Joue sans pub, défie qui tu veux.</h1>
    <p>
      Premium arrive bientôt. Il retirera la publicité et élargira les limites
      de défis et de salons. Il ne change rien aux duels : même chrono, mêmes
      questions, même Elo.
    </p>
    <button class="premium-page__cta" type="button" data-open-waitlist>
      Rejoindre la liste
    </button>
  </div>
</BaseLayout>

<style>
  .premium-page {
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 96px) 24px;
    display: grid;
    gap: 28px;
  }

  .premium-page__eyebrow {
    font-size: 14px;
    font-weight: 500;
    color: var(--jo-accent-ink);
  }

  .premium-page h1 {
    margin: 0;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.02;
    font-weight: 700;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .premium-page p {
    margin: 0;
    max-width: 600px;
    font-size: 18px;
    line-height: 28px;
    color: var(--jo-muted);
  }

  .premium-page__cta {
    justify-self: start;
    height: 50px;
    padding: 0 22px;
    border: 0;
    border-radius: 10px;
    background: var(--jo-accent);
    color: var(--jo-on-accent);
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
  }

  @media (max-width: 760px) {
    .premium-page {
      padding: 48px 24px;
    }
  }
</style>
