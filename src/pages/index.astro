---
/** Accueil (`/site/accueil` du lab, `design/specs/site/accueil.md`) : une seule action, télécharger l'app. */
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryCloud from "../components/CategoryCloud.astro";
import CtaBand from "../components/CtaBand.astro";
import FactRow from "../components/FactRow.astro";
import FaqList from "../components/FaqList.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import LinkButton from "../components/LinkButton.astro";
import PlanCompare from "../components/PlanCompare.astro";
import RankStrip from "../components/RankStrip.astro";
import SiteHero from "../components/SiteHero.astro";
import SiteLink from "../components/SiteLink.astro";
import SiteSection from "../components/SiteSection.astro";
import StepList from "../components/StepList.astro";
import StoreButtons from "../components/StoreButtons.astro";
import { FAQ, FAQ_HOME, MODES, RANK_FACTS, SITE, STEPS } from "../data/site";

const jsonLd = [
  { "@context": "https://schema.org", "@type": "Organization", name: "Joutio", url: SITE.url, logo: `${SITE.url}/logo-mark.svg`, email: SITE.email },
  { "@context": "https://schema.org", "@type": "WebSite", name: "Joutio", url: SITE.url, inLanguage: "fr-FR", description: SITE.description },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: FAQ.flatMap((group) => group.items.map((item) => ({ "@type": "Question", name: item.q, acceptedAnswer: { "@type": "Answer", text: item.a } }))),
  },
];
---

<BaseLayout jsonLd={jsonLd} current="/">
  <SiteHero>
    <StoreButtons />
    <p class="jo-type-callout text-jo-muted">ou <SiteLink href={SITE.appUrl}>jouer sur app.joutio.com</SiteLink></p>
  </SiteHero>
  <SiteSection title="Une partie dure à peine plus d’une minute.">
    <StepList steps={STEPS} />
  </SiteSection>
  <SiteSection
    tone="warm"
    title="Ton cadre dit ton niveau."
    lede="Chaque duel classé fait bouger ton Elo. De Fer à Diamant, ton avatar change de cadre et tes adversaires le voient avant la première question."
  >
    <RankStrip />
    <FactRow facts={RANK_FACTS} />
  </SiteSection>
  <SiteSection title="17 univers">
    <CategoryCloud />
  </SiteSection>
  <SiteSection title="Quatre façons de jouer">
    <FeatureGrid features={MODES} />
  </SiteSection>
  <SiteSection
    id="premium"
    title="Gratuit. Premium bientôt."
    lede="Tous les modes et tous les sujets sont gratuits. Premium arrivera plus tard : il retirera la publicité et élargira tes limites, sans aucun avantage en duel."
  >
    <PlanCompare />
  </SiteSection>
  <SiteSection tone="warm" title="Questions fréquentes">
    <LinkButton slot="action" href="/faq/" variant="plain" size="M" class="justify-self-start">Toutes les questions</LinkButton>
    <FaqList items={FAQ_HOME} />
  </SiteSection>
  <CtaBand id="telecharger" title="Ton premier duel démarre en moins de vingt secondes.">
    <StoreButtons class="justify-center" />
    <p class="jo-type-callout text-jo-muted">ou <SiteLink href={SITE.appUrl}>jouer sur app.joutio.com</SiteLink></p>
  </CtaBand>
</BaseLayout>
