---
import BaseLayout from "../layouts/BaseLayout.astro";
import LegalLayout from "../components/LegalLayout.astro";
import { LEGAL } from "../data/legal";
---

<BaseLayout
  title="Mentions légales"
  description="Éditeur, directeur de publication, hébergeur et propriété intellectuelle du site Joutio."
  noindex={!LEGAL.ready}
>
  <LegalLayout title="Mentions légales" notice="mentions légales">

      <h2>Éditeur du site</h2>
      <p>
        Le site <strong>joutio.com</strong> est édité par <strong>{LEGAL.entity}</strong>,
        {LEGAL.legalForm} au capital de {LEGAL.capital} €, immatriculée au RCS de
        {LEGAL.rcs} sous le numéro {LEGAL.siren}, dont le siège est situé{" "}
        {LEGAL.address}.
      </p>

      <h2>Directeur de la publication</h2>
      <p>{LEGAL.director}.</p>

      <h2>Hébergement</h2>
      <p>{LEGAL.host}.</p>

      <h2>Contact</h2>
      <p>
        <a href={`mailto:${LEGAL.contactEmail}`}>{LEGAL.contactEmail}</a>
      </p>

      <h2>Propriété intellectuelle</h2>
      <p>
        La marque Joutio, le logo, les textes, les illustrations et les éléments
        graphiques du site sont protégés. Toute reproduction ou adaptation sans
        autorisation écrite est interdite, sauf mention contraire.
      </p>
      <p>
        Les polices Geist et Geist Mono sont distribuées sous SIL Open Font
        License 1.1. Les icônes Phosphor sont distribuées sous licence MIT.
      </p>

      <h2>Données personnelles</h2>
      <p>
        Le traitement des données est décrit dans la
        <a href="https://app.joutio.com/privacy">politique de confidentialité</a>.
        Pour exercer tes droits, écris à{" "}
        <a href={`mailto:${LEGAL.dpoEmail}`}>{LEGAL.dpoEmail}</a>.
      </p>
  </LegalLayout>
</BaseLayout>
