---
/** Contact (`/site/contact` du lab) : formulaire à gauche, support à droite. */
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import InfoCard from "../components/InfoCard.astro";
import PageHero from "../components/PageHero.astro";
import SiteInner from "../components/SiteInner.astro";
import SiteLink from "../components/SiteLink.astro";
import { SITE } from "../data/site";
---

<BaseLayout title="Contact" description="Une question, un bug, un partenariat ? Écris à l'équipe Joutio." current="/contact/">
  <PageHero eyebrow="Contact" title="Écris-nous">
    <Fragment slot="lede">
      On répond en général sous deux jours ouvrés. Pour supprimer ton compte, passe plutôt par les <SiteLink href="/data-deletion/"
        >réglages de l’appli</SiteLink
      >.
    </Fragment>
  </PageHero>
  <SiteInner class="grid gap-10 pb-16 @5xl:grid-cols-[minmax(0,1fr)_360px] @5xl:pb-24">
    <ContactForm />
    <div class="grid content-start gap-4">
      <InfoCard title="Support et données">
        <SiteLink href={`mailto:${SITE.email}`} class="jo-type-callout w-fit">{SITE.email}</SiteLink>
      </InfoCard>
    </div>
  </SiteInner>
</BaseLayout>
