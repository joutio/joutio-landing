---
/** À propos (`/site/a-propos` du lab) : intention, trois engagements, renvoi vers le contact. */
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import LinkButton from "../components/LinkButton.astro";
import NoteBand from "../components/NoteBand.astro";
import PageHero from "../components/PageHero.astro";
import SiteInner from "../components/SiteInner.astro";
import { ABOUT } from "../data/site";
---

<BaseLayout
  title="À propos"
  description="Joutio est né d'une envie simple : retrouver la tension d'un duel de culture générale entre amis, sur téléphone, en une minute."
  current="/a-propos/"
>
  <PageHero eyebrow={ABOUT.eyebrow} title={ABOUT.title} lede={ABOUT.lede} />
  <SiteInner class="grid gap-12 pb-16 @5xl:pb-24">
    <FeatureGrid features={ABOUT.values} columns={3} />
    <NoteBand text={ABOUT.band}>
      <LinkButton href="/contact/" variant="tinted" size="M">Nous contacter</LinkButton>
    </NoteBand>
  </SiteInner>
</BaseLayout>
