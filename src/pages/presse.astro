---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../data/site";
---

<BaseLayout
  title="Presse"
  description="Interviews, chiffres, accès anticipé : contacte l'équipe presse de Joutio."
>
  <div class="press-page">
    <div class="press-page__intro">
      <span class="press-page__eyebrow">Presse</span>
      <h1>Parler de Joutio.</h1>
      <p>
        Interviews, chiffres, accès anticipé : écris-nous. On répond en général
        sous deux jours ouvrés.
      </p>
    </div>

    <div class="press-card">
      <b class="press-card__title">Presse</b>
      <p>
        Interviews, chiffres, accès anticipé :
        <a href={`mailto:${SITE.pressEmail}`}>{SITE.pressEmail}</a>
      </p>

      <div class="press-card__downloads">
        <div class="press-download">
          <span class="press-download__icon"><i class="ph ph-shapes"></i></span>
          <div>
            <b>Logos</b>
            <span>SVG · PNG · 1,2 Mo</span>
          </div>
          <i class="ph ph-download-simple"></i>
        </div>
        <div class="press-download">
          <span class="press-download__icon"><i class="ph ph-device-mobile"></i></span>
          <div>
            <b>Captures d'écran</b>
            <span>PNG · 8 écrans · 14 Mo</span>
          </div>
          <i class="ph ph-download-simple"></i>
        </div>
        <div class="press-download">
          <span class="press-download__icon"><i class="ph ph-palette"></i></span>
          <div>
            <b>Guide de marque</b>
            <span>PDF · 3,4 Mo</span>
          </div>
          <i class="ph ph-download-simple"></i>
        </div>
        <div class="press-download">
          <span class="press-download__icon"><i class="ph ph-file-text"></i></span>
          <div>
            <b>Fiche de présentation</b>
            <span>PDF · 1 page</span>
          </div>
          <i class="ph ph-download-simple"></i>
        </div>
      </div>
    </div>

    <div class="press-card">
      <b class="press-card__title">Support et données</b>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
  </div>
</BaseLayout>

<style>
  .press-page {
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 96px) 24px;
    display: grid;
    gap: 32px;
  }

  .press-page__intro {
    display: grid;
    gap: 16px;
  }

  .press-page__eyebrow {
    font-size: 14px;
    font-weight: 500;
    color: var(--jo-accent-ink);
  }

  .press-page h1 {
    margin: 0;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.02;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .press-page__intro p {
    margin: 0;
    max-width: 640px;
    font-size: 18px;
    line-height: 28px;
    color: var(--jo-muted);
  }

  .press-card {
    padding: 24px;
    border-radius: 18px;
    background: var(--jo-surface);
    display: grid;
    gap: 14px;
  }

  .press-card__title {
    font-size: 18px;
  }

  .press-card p {
    margin: 0;
    font-size: 15px;
    line-height: 22px;
    color: var(--jo-muted);
  }

  .press-card__downloads {
    display: grid;
    gap: 8px;
  }

  .press-download {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 10px 12px;
    border-radius: 10px;
    background: var(--jo-raised);
  }

  .press-download__icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--jo-hover);
    display: grid;
    place-items: center;
  }

  .press-download__icon i {
    font-size: 20px;
  }

  .press-download div {
    min-width: 0;
    display: grid;
    gap: 2px;
  }

  .press-download b {
    font-size: 14px;
  }

  .press-download span {
    font-family: var(--jo-font-mono);
    font-size: 12px;
    color: var(--jo-muted);
  }

  .press-download > i {
    font-size: 20px;
    color: var(--jo-muted);
  }

  @media (max-width: 760px) {
    .press-page {
      padding: 48px 24px;
    }
  }
</style>
