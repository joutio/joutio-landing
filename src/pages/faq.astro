---
/** FAQ (`/site/faq` du lab) : toutes les questions par groupe, renvoi vers le contact. */
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqGroups from "../components/FaqGroups.astro";
import LinkButton from "../components/LinkButton.astro";
import NoteBand from "../components/NoteBand.astro";
import PageHero from "../components/PageHero.astro";
import SiteInner from "../components/SiteInner.astro";
import { FAQ } from "../data/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.flatMap((group) => group.items.map((item) => ({ "@type": "Question", name: item.q, acceptedAnswer: { "@type": "Answer", text: item.a } }))),
};
---

<BaseLayout
  title="Questions fréquentes"
  description="Comment se déroule un duel, comment fonctionne l'Elo, comment supprimer ton compte : les réponses aux questions les plus fréquentes."
  jsonLd={jsonLd}
  current="/faq/"
>
  <PageHero eyebrow="Aide" title="Questions fréquentes" />
  <SiteInner class="grid gap-12 pb-16 @5xl:pb-24">
    <div class="max-w-[880px]"><FaqGroups groups={FAQ} /></div>
    <NoteBand text="Pas de réponse ici ?">
      <LinkButton href="/contact/" variant="tinted" size="M">Écris-nous</LinkButton>
    </NoteBand>
  </SiteInner>
</BaseLayout>
