---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../data/site";
---

<BaseLayout
  title="Rejoindre un salon"
  description="Ouvre le salon Joutio dans l'application ou sur le web."
  noindex
>
  <div class="container">
    <div class="join-card" data-join>
      <p class="eyebrow">Invitation</p>
      <h1>On t'invite à un duel.</h1>
      <p>
        Sept manches de dix secondes. Le duel démarre dès que vous êtes deux
        dans le salon.
      </p>

      <p class="join-card__code">
        Salon <strong data-room-id>—</strong>
      </p>

      <div class="join-card__actions">
        <a class="btn btn--primary" data-open-app href={SITE.appUrl}>Ouvrir dans l'app</a>
        <a class="btn btn--secondary" data-open-web href={SITE.appUrl}>Jouer sur le web</a>
      </div>

      <p class="waitlist-form__status" data-join-status role="status" aria-live="polite"></p>

      <p class="muted" style="font-size:13px;line-height:20px">
        Pas encore de compte ? Tu le crées en 20 secondes avec ton e-mail, sans
        mot de passe. Android d'abord, iOS ensuite.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-join]");
  if (root) {
    const match = window.location.pathname.match(/\/join\/([^/]+)\/?$/);
    const roomId = match?.[1] ?? new URLSearchParams(window.location.search).get("room") ?? "";

    const roomLabel = root.querySelector<HTMLElement>("[data-room-id]");
    const openApp = root.querySelector<HTMLAnchorElement>("[data-open-app]");
    const openWeb = root.querySelector<HTMLAnchorElement>("[data-open-web]");
    const status = root.querySelector<HTMLElement>("[data-join-status]");

    if (roomId) {
      if (roomLabel) roomLabel.textContent = roomId;
      if (openApp) openApp.href = `joutio://join/${roomId}`;
      if (openWeb) openWeb.href = `${location.origin.replace("joutio.com", "app.joutio.com")}/join/${roomId}`;
    } else {
      if (roomLabel) roomLabel.textContent = "lien incomplet";
      if (status) {
        status.textContent = "Ce lien ne contient pas d'identifiant de salon. Demande un nouveau lien à ton adversaire.";
        status.dataset.tone = "error";
      }
      if (openApp) openApp.setAttribute("aria-disabled", "true");
      if (openWeb) openWeb.setAttribute("aria-disabled", "true");
    }
  }
</script>
