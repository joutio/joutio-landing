---
/** 404 (`/site/404` du lab) : retour à l'accueil, téléchargement. */
import BaseLayout from "../layouts/BaseLayout.astro";
import LinkButton from "../components/LinkButton.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas ou a été déplacée." noindex>
  <PageHero eyebrow="404" title="Cette page n’existe pas." lede="Le lien est peut-être cassé, ou la page a été déplacée. Retourne à l’accueil ou télécharge l’app.">
    <div class="flex flex-wrap gap-3 pt-4 pb-16 @5xl:pb-24">
      <LinkButton href="/">Retour à l’accueil</LinkButton>
      <LinkButton href="/#telecharger" variant="tinted">Télécharger l’app</LinkButton>
    </div>
  </PageHero>
</BaseLayout>
