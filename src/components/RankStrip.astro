---
/**
 * Les sept rangs (`RankStrip` du lab) : avatar encadré, nom du rang, seuil d'Elo. En compact, la rangée défile
 * (aimantée) : flèches latérales et points de page signalent la suite ; `src/scripts/site.ts` les tient à jour.
 * La zone de défilement déborde de 20 px en haut et en bas pour ne pas rogner le halo des cadres.
 */
import { RANKS } from "../data/site";
import { iconButtonStyles } from "../lib/button";
import { cn } from "../lib/cn";
import Icon from "./Icon.astro";
import RankAvatar from "./RankAvatar.astro";

const elo = (min: number) => (min === 0 ? "Départ" : `${min.toLocaleString("fr-FR")} Elo`);
const ink = (tier: string) => `color: color-mix(in oklab, var(--jo-tier-${tier.toLowerCase()}) 60%, var(--jo-text))`;
const arrow = cn(iconButtonStyles({ variant: "gray", size: "S" }), "absolute top-9 -translate-y-1/2 shadow-jo @3xl:hidden");
---

<div class="relative grid gap-4" data-rank-strip>
  <ul
    class="jo-no-scrollbar -mx-5 -my-5 flex snap-x snap-mandatory scroll-px-5 gap-6 overflow-x-auto px-5 py-5 @3xl:mx-0 @3xl:my-0 @3xl:grid @3xl:grid-cols-7 @3xl:overflow-visible @3xl:px-0 @3xl:py-0"
    data-rank-scroller
  >
    {
      RANKS.map((rank) => (
        <li class="grid flex-none snap-start justify-items-center gap-3 text-center">
          <RankAvatar tier={rank.tier} name={rank.name} src={`/site/avatars/${rank.tier.toLowerCase()}.svg`} />
          <span class="grid gap-0.5">
            <span class="jo-type-headline" style={ink(rank.tier)}>{rank.label}</span>
            <span class="jo-type-caption font-mono text-jo-muted">{elo(rank.minElo)}</span>
          </span>
        </li>
      ))
    }
  </ul>
  <button type="button" class={cn(arrow, "-left-2")} aria-label="Rangs précédents" data-rank-prev hidden>
    <Icon name="caret-left" size={18} />
  </button>
  <button type="button" class={cn(arrow, "-right-2")} aria-label="Rangs suivants" data-rank-next hidden>
    <Icon name="caret-right" size={18} />
  </button>
  <div role="img" class="flex items-center justify-center gap-1.5 @3xl:hidden" data-rank-dots hidden></div>
</div>
