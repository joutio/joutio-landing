---
/**
 * Les sept rangs (`RankStrip` du lab) : avatar encadré, nom du rang, seuil d'Elo. En compact, la rangée défile
 * librement au doigt, sans aimant ni flèches (2026-11-11) : la rangée qui déborde du bord signale la suite.
 * La zone de défilement déborde de 20 px en haut et en bas pour ne pas rogner le halo des cadres. Aucun script.
 */
import { RANKS } from "../data/site";
import RankAvatar from "./RankAvatar.astro";

const elo = (min: number) => (min === 0 ? "Départ" : `${min.toLocaleString("fr-FR")} Elo`);
const ink = (tier: string) => `color: color-mix(in oklab, var(--jo-tier-${tier.toLowerCase()}) 60%, var(--jo-text))`;
---

<ul class="jo-no-scrollbar -mx-5 -my-5 flex gap-6 overflow-x-auto overscroll-x-contain px-5 py-5 @3xl:mx-0 @3xl:my-0 @3xl:grid @3xl:grid-cols-7 @3xl:overflow-visible @3xl:px-0 @3xl:py-0">
  {
    RANKS.map((rank) => (
      <li class="grid flex-none justify-items-center gap-3 text-center">
        <RankAvatar tier={rank.tier} name={rank.name} src={`/site/avatars/${rank.tier.toLowerCase()}.svg`} />
        <span class="grid gap-0.5">
          <span class="jo-type-headline" style={ink(rank.tier)}>{rank.label}</span>
          <span class="jo-type-caption font-mono text-jo-muted">{elo(rank.minElo)}</span>
        </span>
      </li>
    ))
  }
</ul>
