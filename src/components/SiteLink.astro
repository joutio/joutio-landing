---
/** Lien de texte du site : souligné au survol, focus visible (`SiteLink` du lab). */
interface Props {
  href: string;
  class?: string;
}
const { href, class: className } = Astro.props;
import { cn } from "../lib/cn";
---

<a href={href} class={cn("jo-focus jo-transition rounded-jo-xs font-semibold text-jo-accent-ink underline-offset-4 hover:underline", className)}><slot /></a>
