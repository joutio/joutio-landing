---
export interface Props {
  size?: number;
  withWordmark?: boolean;
  class?: string;
}

const { size = 34, withWordmark = true, class: className } = Astro.props;
---

<span class:list={["brand", className]}>
  <img
    class="brand-mark"
    src="/logo-mark.svg"
    alt=""
    width={size}
    height={size}
    aria-hidden="true"
  />
  {withWordmark && <span>joutio</span>}
</span>
