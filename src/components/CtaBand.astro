---
/** Appel final (`CtaBand` du lab) : marque, promesse, mêmes actions que le hero. */
import Logo from "./Logo.astro";
import SiteInner from "./SiteInner.astro";

interface Props {
  id?: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} class="scroll-mt-16 py-16 @5xl:py-24">
  <SiteInner>
    <div class="grid justify-items-center gap-6 rounded-jo-xl border border-jo-border bg-jo-surface px-6 py-12 text-center @3xl:px-12 @3xl:py-16">
      <Logo size={64} />
      <h2 class="jo-type-large-title max-w-[640px] text-balance">{title}</h2>
      <div class="flex flex-col items-center gap-4"><slot /></div>
    </div>
  </SiteInner>
</section>
