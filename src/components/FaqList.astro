---
/** Questions en `<details>` natifs (`FaqList` du lab) : ouvrables sans JavaScript. */
import type { FaqItem } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  items: readonly FaqItem[];
  openFirst?: boolean;
}
const { items, openFirst = true } = Astro.props;
---

<div class="grid border-t border-jo-border">
  {
    items.map((item, index) => (
      <details open={openFirst && index === 0} class="group border-b border-jo-border">
        <summary class="jo-type-headline jo-focus-inset flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 [&::-webkit-details-marker]:hidden">
          {item.q}
          <Icon name="plus" class="jo-transition flex-none text-jo-muted group-open:rotate-45" />
        </summary>
        <p class="jo-type-body max-w-[680px] pb-5 text-pretty text-jo-muted">{item.a}</p>
      </details>
    ))
  }
</div>
