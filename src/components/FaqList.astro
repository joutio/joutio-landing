---
import { FAQ } from "../data/site";

export interface Props {
  groups: typeof FAQ;
  openFirst?: boolean;
}

const { groups, openFirst = true } = Astro.props;
let index = 0;
---

<div class="faq-groups">
  {groups.map((group) => (
    <section class="faq-group">
      <h2 class="faq-group__title">{group.group}</h2>
      <div class="faq-list">
        {group.items.map((item) => {
          const open = openFirst && index === 0;
          index += 1;
          return (
            <details class="faq-item" open={open}>
              <summary>
                {item.q}
                <i class:list={["ph", open ? "ph-minus" : "ph-plus"]}></i>
              </summary>
              <p>{item.a}</p>
            </details>
          );
        })}
      </div>
    </section>
  ))}
</div>
