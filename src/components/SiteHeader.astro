---
import { NAV } from "../data/site";
import Logo from "./Logo.astro";

const path = Astro.url.pathname;

function isCurrent(href: string) {
  if (href.startsWith("/#")) return path === "/";
  return path === href || path === href.replace(/\/$/, "");
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" aria-label="Joutio, accueil">
      <Logo size={32} />
    </a>

    <nav class="site-nav" aria-label="Navigation principale">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="btn btn--ghost btn--sm" href="https://app.joutio.com">
        Jouer sur le web
      </a>
      <button class="btn btn--primary btn--sm" type="button" data-open-waitlist>
        Télécharger
      </button>

      <details class="header-menu">
        <summary aria-label="Ouvrir le menu">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="header-menu__panel">
          {NAV.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
          <a href="https://app.joutio.com">Jouer sur le web</a>
        </div>
      </details>
    </div>
  </div>
</header>
