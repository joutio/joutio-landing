---
/** Pied de page (`SiteFooter` du lab) : marque, colonnes de liens (dont le juridique), mention. */
import { FOOTER_LINKS, FOOTER_NOTE } from "../data/site";
import Logo from "./Logo.astro";
import SiteInner from "./SiteInner.astro";
---

<footer class="border-t border-jo-border bg-jo-canvas">
  <SiteInner class="grid gap-10 py-14 @3xl:grid-cols-[1fr_2fr]">
    <div class="grid content-start gap-3">
      <Logo variant="lockup" size={28} />
      <p class="jo-type-callout max-w-[280px] text-jo-muted">Le quiz qui se joue à deux.</p>
    </div>
    <div class="grid grid-cols-2 gap-8 @xl:grid-cols-3">
      {
        FOOTER_LINKS.map((column) => (
          <nav aria-label={column.title} class="grid content-start gap-2">
            <h2 class="jo-type-caption font-semibold text-jo-muted">{column.title}</h2>
            {column.links.map((link) => (
              <a href={link.href} class="jo-type-callout jo-focus w-fit rounded-jo-xs text-jo-text hover:underline">
                {link.label}
              </a>
            ))}
          </nav>
        ))
      }
    </div>
    <p class="jo-type-caption text-jo-muted @3xl:col-span-2">{FOOTER_NOTE}</p>
  </SiteInner>
</footer>
