---
/** Les univers (`CategoryCloud` du lab) : pastille à la couleur de la catégorie. */
import { CATEGORIES } from "../data/site";
import Icon from "./Icon.astro";

const color = (code: string) => `var(--jo-category-${code.toLowerCase().replace(/_/g, "-")})`;
---

<ul class="flex flex-wrap gap-2">
  {
    CATEGORIES.map((category) => (
      <li class="jo-type-callout flex min-h-11 items-center gap-2 rounded-jo-full border border-jo-border bg-jo-surface py-1.5 pr-4 pl-1.5 font-semibold">
        <span
          class="grid size-8 place-items-center rounded-jo-full"
          style={`background: color-mix(in oklab, ${color(category.code)} 16%, transparent); color: color-mix(in oklab, ${color(category.code)} 70%, var(--jo-text))`}
        >
          <Icon name={category.icon} weight="fill" size={18} />
        </span>
        {category.label}
      </li>
    ))
  }
</ul>
