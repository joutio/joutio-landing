# Point d'entrée du formulaire de liste d'attente (Brevo, Resend, BFF…).
# Vide = le formulaire affiche un repli mailto vers contact@joutio.com.
PUBLIC_WAITLIST_ENDPOINT=

# Point d'entrée du formulaire de contact.
# Vide = le formulaire ouvre un mailto vers contact@joutio.com.
PUBLIC_CONTACT_ENDPOINT=

# Empreinte SHA-256 du certificat de signature Android release, utilisée pour
# vérifier les App Links `joutio.com/join/{roomId}`.
# Format : AA:BB:CC:… (64 octets hexadécimaux, séparés par des deux-points).
ANDROID_SHA256=
